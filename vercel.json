{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "env": {
        "NODE_ENV": "production"
    },
    "functions": {
        "src/index.ts": {
            "memory": 1024,
            "maxDuration": 60,
            "includeFiles": "node_modules/swagger-ui-dist/**"
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/index.ts"
        }
    ]
}
